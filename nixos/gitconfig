[user]
	email = haakon.skogsrud@pm.me
	name = Håkon Skogsrud
[push]
	autoSetupRemote = true
[core]
	pager = delta
	editor = nvim

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
