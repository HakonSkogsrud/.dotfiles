{
    "workbench.iconTheme": "symbols",
    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",

    // ── Window ─────────────────────────────────────────────────────────────────
    "window.zoomLevel": 0.6,
    "window.openFoldersInNewWindow": "off",
    "window.customTitleBarVisibility": "windowed",

    // ── Editor ─────────────────────────────────────────────────────────────────
    "editor.fontSize": 13,
    "editor.fontVariations": false,
    "editor.minimap.enabled": false,
    "editor.scrollbar.verticalScrollbarSize": 6,
    "editor.scrollbar.horizontalScrollbarSize": 6,
    "editor.accessibilitySupport": "off",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,

    // ── Diff editor ────────────────────────────────────────────────────────────
    "diffEditor.ignoreTrimWhitespace": false,

    // ── Debug ──────────────────────────────────────────────────────────────────
    "debug.console.fontFamily": "",

    // ── Files ──────────────────────────────────────────────────────────────────
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 10,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*_cache": true,
        "**/*egg-info": true
    },

    // ── Search ─────────────────────────────────────────────────────────────────
    "search.exclude": {
        "**/.venv": true
    },

    // ── Explorer ───────────────────────────────────────────────────────────────
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,

    // ── Terminal ───────────────────────────────────────────────────────────────
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.shellIntegration.history": 1000,
    "terminal.integrated.shellIntegration.quickFixEnabled": false,
    "terminal.integrated.shellIntegration.showCommandGuide": false,

    // ── Git ────────────────────────────────────────────────────────────────────
    "git.autofetch": true,
    "git.path": "/opt/homebrew/bin/git",
    "git.confirmSync": false,
    "git.suggestSmartCommit": false,
    "git.openAfterClone": "alwaysNewWindow",
    "git.defaultCloneDirectory": "~/Workspace",
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": true,

    // ── Notebooks / Jupyter ────────────────────────────────────────────────────
    "notebook.editorOptionsCustomizations": {
        "editor.fontSize": 12
    },
    "notebook.output.fontSize": 12,
    "notebook.output.fontFamily": "JetBrainsMono Nerd Font Mono",
    "notebook.markup.fontSize": 14,
    "notebook.markup.fontFamily": "Avenir Next",
    "jupyter.askForKernelRestart": false,

    // ── Markdown ───────────────────────────────────────────────────────────────
    "markdown.preview.fontSize": 13,
    "markdown.preview.fontFamily": "Avenir Next",

    // ── Python ─────────────────────────────────────────────────────────────────
    "python.analysis.typeCheckingMode": "basic",
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",

    // ── GitHub Copilot ─────────────────────────────────────────────────────────
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,

    // ── GitHub Pull Requests ───────────────────────────────────────────────────
    "githubPullRequests.pullBranch": "never",

    // ── Chat ───────────────────────────────────────────────────────────────────
    "chat.fontSize": 13,
    "chat.viewSessions.orientation": "stacked",
    "chat.mcp.gallery.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "uv": true,
        "git checkout": true,
        "git add": true,
        "git commit": true,
        "git push": true,
        "mkdir": true,
        "mv": true,
        "cp": true,
        "gh": true,
        "git stash": true,
        "printf": true,
        "git remote": true,
        "git reset": true,
        "git restore": true,
        "git fetch": true,
        "git rev-parse": true,
        "git reflog": true,
        "git patch-id": true,
        "git switch": true,
        "diff": true
    },
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://docs.github.com": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://github.com": true,
        "https://raw.githubusercontent.com": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://artificialanalysis.ai": true,
        "https://lmarena.ai": {
            "approveRequest": true,
            "approveResponse": false
        },
        "https://mlflow.org/docs/latest/llms/tracing/index.html": true,
        "https://mlflow.org/docs/latest/llms/tracing": true,
        "https://mlflow.org/docs/latest/llms": true,
        "https://mlflow.org/docs/latest": true,
        "https://mlflow.org/docs": true,
        "https://mlflow.org": true,
        "https://github.com/mlflow/mlflow/issues": true,
        "https://github.com/mlflow/mlflow": true,
        "https://github.com/mlflow": true,
        "https://builders-intranet-admin.apps-int.gjensidige.io": {
            "approveRequest": true,
            "approveResponse": false
        },
        "https://docs.streamlit.io": {
            "approveRequest": false,
            "approveResponse": true
        }
    },

    // ── Security ───────────────────────────────────────────────────────────────
    "security.workspace.trust.untrustedFiles": "open",

    // ── Extensions ─────────────────────────────────────────────────────────────
    "hediet.vscode-drawio.resizeImages": null,

