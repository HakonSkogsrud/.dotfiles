    "dev.containers.dockerPath": "/opt/homebrew/bin/podman",
    "workbench.colorTheme": "Dark Modern",
    "workbench.experimental.modernUIEditorTabStyle": "pill",
    "security.promptForLocalFileProtocolHandling": false
}