{
  // Window
  "window.customTitleBarVisibility": "never",
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0.8,
  // Workbench layout
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.experimental.modernUI": false,
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.modernUIFrostedGlass": false,
  "workbench.shadows": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  // Editor
  "editor.fontFamily": "BlexMono Nerd Font Mono",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.glyphMargin": false,
  "editor.lineNumbers": "off",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderWhitespace": "none",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.selectionClipboard": false,
  // Files and Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.associations": {
    "*.conf.j2": "ini",
    "*.hwdb.j2": "ini",
    "*.ini.j2": "ini",
    "*.service.j2": "ini",
    "*.sh.j2": "shellscript",
    "*.timer.j2": "ini",
    "*.yml.j2": "yaml",
    ".env.j2": "ini"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  // Terminal
  "terminal.integrated.allowChords": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.fontZoomIn",
    "workbench.action.terminal.fontZoomOut",
    "workbench.action.togglePanel",
    "workbench.action.terminal.kill"
  ],
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.fontFamily": "BlexMono Nerd Font Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // Python
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  // AI and chat
  "chat.disableAIFeatures": true,
  "chat.editor.fontSize": 13,
  "chat.instructionsFilesLocations": {
    "README.md": true
  },
  "chat.tools.terminal.autoApprove": {
    "git add": true,
    "git commit": true,
    "git push": true
  },
  // Privacy and workspace trust
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  // Theme: follow the system light/dark preference.
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "Dark Modern",
  "workbench.iconTheme": "symbols",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  // Theme colors
  "workbench.colorCustomizations": {
    "terminalOverviewRuler.border": "#00000000",
    "terminalOverviewRuler.cursorForeground": "#00000000",
    "terminalOverviewRuler.findMatchForeground": "#00000000",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#00000000",
    "scrollbarSlider.activeBackground": "#00000000",
    "scrollbar.shadow": "#00000000"
  },
  "window.commandCenter": false,
  "workbench.browser.showInTitleBar": false,
  "workbench.layoutControl.enabled": false
}