layout {

    focus-ring {
        active-color   "#75a6d7"
        inactive-color "#1a1f23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#75a6d7"
        inactive-color "#1a1f23"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#75a6d7"
        inactive-color "#1f4d7b"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#75a6d780"
    }
}

recent-windows {
    highlight {
        active-color "#75a6d7"
        urgent-color "#fd4663"
    }
}
