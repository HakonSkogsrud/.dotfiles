layout {

    focus-ring {
        active-color   "#55dbc7"
        inactive-color "#0b151a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#55dbc7"
        inactive-color "#0b151a"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#55dbc7"
        inactive-color "#005047"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#55dbc780"
    }
}

recent-windows {
    highlight {
        active-color "#55dbc7"
        urgent-color "#ffb4ab"
    }
}
