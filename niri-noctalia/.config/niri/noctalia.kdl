layout {

    focus-ring {
        active-color   "#ebeff0"
        inactive-color "#1c2021"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#ebeff0"
        inactive-color "#1c2021"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#ebeff0"
        inactive-color "#849ea4"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#ebeff080"
    }
}

recent-windows {
    highlight {
        active-color "#ebeff0"
        urgent-color "#fd4663"
    }
}
