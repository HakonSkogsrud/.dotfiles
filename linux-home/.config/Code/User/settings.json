{
  "mistral-vibe.agentPath": "/run/current-system/sw/bin/vibe-acp",
  // ── Window ──────────────────────────────────────────────
  "window.zoomLevel": 0.8,
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  // ── Editor ──────────────────────────────────────────────
  "editor.fontSize": 13,
  "editor.fontFamily": "CommitMono Nerd Font Mono",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "none",
  "editor.selectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  // ── Terminal ────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.allowChords": false,
  // ── Workbench & Theme ───────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "symbols",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.preferredDarkColorTheme": "Visual Studio Dark",
  "workbench.colorCustomizations": {
    "[Visual Studio Dark]": {
      "activityBar.background": "#2e2e32",
      "statusBar.background": "#252525",
      "tab.inactiveBackground": "#2e2e32",
      "tab.activeBackground": "#2e2e32",
      "editorGroupHeader.tabsBackground": "#252525"
    }
  },
  // ── Files & Explorer ────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.untrustedFiles": "open",
  // ── Git ─────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  // ── Python ──────────────────────────────────────────────
  "python.defaultInterpreterPath": "/run/current-system/sw/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  // ── Copilot & Chat ──────────────────────────────────────
  "chat.editor.fontSize": 13,
  "chat.instructionsFilesLocations": {
    "README.md": true
  },
  "chat.tools.terminal.autoApprove": {
    "git add": true,
    "git commit": true,
    "git push": true,
    "test": true,
    "cp": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  // ── Extensions ──────────────────────────────────────────
  "hediet.vscode-drawio.resizeImages": null,
  "files.autoSaveDelay": 10,
  "window.customTitleBarVisibility": "never",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "window.autoDetectColorScheme": true,
  "window.openFoldersInNewWindow": "on",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://ai.google.dev": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://docs.continue.dev": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "mistral-vibe-code.telemetry.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false
}