{
  // ── Window ──────────────────────────────────────────────
  "window.zoomLevel": 0.7,
  "window.titleBarStyle": "custom",
  // ── Editor ──────────────────────────────────────────────
  "editor.fontSize": 13,
  "editor.fontFamily": "CommitMono Nerd Font Mono",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "none",
  "editor.selectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  // ── Terminal ────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // ── Workbench & Theme ───────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "symbols",
  "workbench.preferredLightColorTheme": "Light Modern",
  // ── Files & Explorer ────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveDelay": 10,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.untrustedFiles": "open",
  // ── Git ─────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  // ── Python ──────────────────────────────────────────────
  "python.defaultInterpreterPath": "/run/current-system/sw/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  // ── Extensions ──────────────────────────────────────────
  "hediet.vscode-drawio.resizeImages": null,
  "window.customTitleBarVisibility": "never",
  "window.autoDetectColorScheme": true,
  "window.openFoldersInNewWindow": "on",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "One Dark italic",
        "scope": [
          "comment",
          "entity.other.attribute-name",
          "keyword",
          "markup.underline.link",
          "storage.modifier",
          "storage.type",
          "string.url",
          "variable.language.super",
          "variable.language.this"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "name": "One Dark italic reset",
        "scope": [
          "keyword.operator",
          "keyword.other.type",
          "storage.modifier.import",
          "storage.modifier.package",
          "storage.type.built-in",
          "storage.type.function.arrow",
          "storage.type.generic",
          "storage.type.java",
          "storage.type.primitive"
        ],
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  "workbench.colorTheme": "One Dark",
  "glassit.alpha": 100,
  "workbench.preferredDarkColorTheme": "Dark Modern",
}