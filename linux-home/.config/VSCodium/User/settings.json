{
  // ── Window ──────────────────────────────────────────────
  "window.zoomLevel": 0.8,
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  // ── Editor ──────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontFamily": "CommitMono Nerd Font Mono",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "none",
  "editor.selectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  // ── Terminal ────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // ── Workbench & Theme ───────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "symbols",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  // ── Files & Explorer ────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveDelay": 10,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.untrustedFiles": "open",
  // ── Git ─────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  // ── Python ──────────────────────────────────────────────
  "python.defaultInterpreterPath": "/run/current-system/sw/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  // ── Extensions ──────────────────────────────────────────
  "hediet.vscode-drawio.resizeImages": null,
  "window.customTitleBarVisibility": "never",
  "window.autoDetectColorScheme": true,
  "window.openFoldersInNewWindow": "on",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      //========================================================
      // General Window & Layout
      //========================================================
      "titleBar.activeBackground": "#232629",
      "titleBar.inactiveBackground": "#232629",
      "activityBar.background": "#232629",
      "activityBar.border": "#232629",
      "statusBar.background": "#232629",
      "statusBar.border": "#232629",
      //========================================================
      // Side Bar
      //========================================================
      "sideBar.background": "#232629",
      "sideBar.border": "#232629",
      "sideBarSectionHeader.background": "#232629",
      "widget.shadow": "#00000000",
      "scrollbar.shadow": "#00000000",
      "listFilterWidget.shadow": "#00000000",
      "sideBarStickyScroll.shadow": "#00000000",
      "panelStickyScroll.shadow": "#232629",
      //========================================================
      // Editor & Tabs
      //========================================================
      "editorGroupHeader.tabsBackground": "#232629",
      "editorGroupHeader.noTabsBackground": "#232629",
      "tab.activeBackground": "#202225",
      "tab.activeBorder": "#232629",
      "tab.inactiveBackground": "#232629",
      //========================================================
      // Lists & Selections
      //========================================================
      "list.activeSelectionBackground": "#232629",
      "list.inactiveSelectionBackground": "#232629"
    },
    "[Light Modern]": {
      "titleBar.activeBackground": "#f5f5f5",
      "titleBar.inactiveBackground": "#f5f5f5",
      "activityBar.background": "#f5f5f5",
      "activityBar.border": "#f5f5f5",
      "statusBar.background": "#f5f5f5",
      "statusBar.border": "#f5f5f5",
    }
  }