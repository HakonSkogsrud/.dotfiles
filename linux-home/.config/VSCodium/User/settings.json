{
  // ── Window ──────────────────────────────────────────────
  "window.zoomLevel": 0.8,
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  // ── Editor ──────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontFamily": "CommitMono Nerd Font Mono",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "none",
  "editor.selectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  // ── Terminal ────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // ── Workbench & Theme ───────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "symbols",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  // ── Files & Explorer ────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveDelay": 10,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.untrustedFiles": "open",
  // ── Git ─────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  // ── Python ──────────────────────────────────────────────
  "python.defaultInterpreterPath": "/run/current-system/sw/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  // ── Extensions ──────────────────────────────────────────
  "hediet.vscode-drawio.resizeImages": null,
  "window.customTitleBarVisibility": "never",
  "window.autoDetectColorScheme": true,
  "window.openFoldersInNewWindow": "on",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      //========================================================
      // General Window & Layout
      //========================================================
      "activityBar.background": "#232629",
      "activityBar.border": "#34383c",
      "statusBar.background": "#232629",
      "statusBar.border": "#34383c",
      //========================================================
      // Side Bar
      //========================================================
      "sideBar.background": "#232629",
      "sideBar.border": "#34383c",
      "sideBarSectionHeader.background": "#232629",
      "widget.shadow": "#00000000",
      "scrollbar.shadow": "#00000000",
      "listFilterWidget.shadow": "#00000000",
      "sideBarStickyScroll.shadow": "#00000000",
      "panelStickyScroll.shadow": "#232629",
      //========================================================
      // Editor & Tabs
      //========================================================
      "editorGroupHeader.tabsBackground": "#232629",
      "editorGroupHeader.noTabsBackground": "#232629",
      "tab.activeBackground": "#202225",
      "tab.activeBorder": "#78aeed",
      "tab.inactiveBackground": "#232629",
      //========================================================
      // Lists & Selections
      //========================================================
      "list.activeSelectionBackground": "#3d4856",
      "list.inactiveSelectionBackground": "#363636"
    },
    "[Light Modern]": {
      //========================================================
      // General Window & Layout
      //========================================================
      "focusBorder": "#3584e4",
      "activityBar.background": "#f5f5f5",
      "activityBar.border": "#deddda",
      "activityBar.foreground": "#2e3436",
      "activityBar.inactiveForeground": "#77767b",
      "activityBar.activeBorder": "#3584e4",
      "statusBar.background": "#f5f5f5",
      "statusBar.border": "#deddda",
      //========================================================
      // Side Bar
      //========================================================
      "sideBar.background": "#f5f5f5",
      "sideBar.border": "#deddda",
      "sideBar.foreground": "#2e3436",
      "sideBarSectionHeader.background": "#f5f5f5",
      "widget.shadow": "#00000000",
      "scrollbar.shadow": "#00000000",
      "listFilterWidget.shadow": "#00000000",
      "sideBarStickyScroll.shadow": "#00000000",
      "panelStickyScroll.shadow": "#deddda",
      //========================================================
      // Editor & Tabs
      //========================================================
      "editorGroup.border": "#deddda",
      "editorGroupHeader.tabsBackground": "#f5f5f5",
      "editorGroupHeader.noTabsBackground": "#f5f5f5",
      "editorGroupHeader.tabsBorder": "#deddda",
      "tab.activeBackground": "#ffffff",
      "tab.activeBorder": "#3584e4",
      "tab.border": "#deddda",
      "tab.inactiveBackground": "#f5f5f5",
      "tab.hoverBackground": "#efedeb",
      //========================================================
      // Lists & Selections
      //========================================================
      "list.activeSelectionBackground": "#d6e4f7",
      "list.activeSelectionForeground": "#2e3436",
      "list.inactiveSelectionBackground": "#e9e7e5",
      "list.hoverBackground": "#efedeb",
      "list.focusBackground": "#e2edf9",
      //========================================================
      // Panels, Inputs & Status
      //========================================================
      "panel.background": "#f5f5f5",
      "panel.border": "#deddda",
      "panelTitle.activeBorder": "#3584e4",
      "input.background": "#ffffff",
      "input.border": "#c7cdd5",
      "inputOption.activeBorder": "#3584e4",
      "badge.background": "#3584e4",
      "badge.foreground": "#ffffff",
      "scrollbarSlider.background": "#c7cdd588",
      "scrollbarSlider.hoverBackground": "#aeb7c288"
    }
  }
}