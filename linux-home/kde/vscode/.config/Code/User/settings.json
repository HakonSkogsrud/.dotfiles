{
  // Window
  "window.customTitleBarVisibility": "never",
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "native",
  "window.zoomLevel": 0.8,
  // Workbench layout
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.experimental.modernUI": false,
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.modernUIFrostedGlass": false,
  "workbench.shadows": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  // Editor
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.glyphMargin": false,
  "editor.lineNumbers": "off",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderWhitespace": "none",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.selectionClipboard": false,
  // Files and Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.associations": {
    "*.conf.j2": "ini",
    "*.hwdb.j2": "ini",
    "*.ini.j2": "ini",
    "*.service.j2": "ini",
    "*.sh.j2": "shellscript",
    "*.timer.j2": "ini",
    "*.yml.j2": "yaml",
    ".env.j2": "ini"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  // Terminal
  "terminal.integrated.allowChords": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.fontZoomIn",
    "workbench.action.terminal.fontZoomOut",
    "workbench.action.togglePanel",
    "workbench.action.terminal.kill"
  ],
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // Python
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  // AI and chat
  "chat.disableAIFeatures": true,
  "chat.editor.fontSize": 13,
  "chat.instructionsFilesLocations": {
    "README.md": true
  },
  "chat.tools.terminal.autoApprove": {
    "git add": true,
    "git commit": true,
    "git push": true
  },
  // Privacy and workspace trust
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  // Theme: follow the system, with a separate Breeze palette for each mode.
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "Dark Modern",
  "workbench.iconTheme": "symbols",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light+",
  // Theme colors
  // Breeze Classic light and dark palettes; dark chrome matches the KDE titlebar.
  "workbench.colorCustomizations": {
    "terminalOverviewRuler.border": "#00000000",
    "terminalOverviewRuler.cursorForeground": "#00000000",
    "terminalOverviewRuler.findMatchForeground": "#00000000",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#00000000",
    "scrollbarSlider.activeBackground": "#00000000",
    "scrollbar.shadow": "#00000000",
    "[Light+]": {
      "foreground": "#232629",
      "focusBorder": "#3DAEE9",
      "titleBar.activeBackground": "#EFF0F1",
      "titleBar.inactiveBackground": "#EFF0F1",
      "titleBar.activeForeground": "#232629",
      "activityBar.background": "#EFF0F1",
      "activityBar.foreground": "#232629",
      "activityBar.border": "#EFF0F1",
      "activityBar.activeBorder": "#3DAEE9",
      "sideBar.background": "#EFF0F1",
      "sideBar.foreground": "#232629",
      "sideBar.border": "#D3D7CF",
      "sideBarSectionHeader.background": "#EFF0F1",
      "editor.background": "#FFFFFF",
      "editor.foreground": "#232629",
      "editorGroupHeader.tabsBackground": "#EFF0F1",
      "editorGroupHeader.noTabsBackground": "#EFF0F1",
      "tab.activeBackground": "#FFFFFF",
      "tab.activeForeground": "#232629",
      "tab.activeBorder": "#FFFFFF",
      "tab.activeBorderTop": "#3DAEE9",
      "tab.inactiveBackground": "#EFF0F1",
      "tab.inactiveForeground": "#616569",
      "tab.border": "#D3D7CF",
      "panel.background": "#EFF0F1",
      "panel.border": "#D3D7CF",
      "statusBar.background": "#EFF0F1",
      "statusBar.foreground": "#232629",
      "statusBar.inactiveBackground": "#EFF0F1",
      "statusBar.border": "#D3D7CF",
      "statusBar.noFolderBackground": "#EFF0F1",
      "statusBar.debuggingBackground": "#EFF0F1",
      "statusBar.debuggingForeground": "#232629",
      "list.activeSelectionBackground": "#D3D7DA",
      "list.activeSelectionForeground": "#232629",
      "list.inactiveSelectionBackground": "#E0E3E5",
      "list.inactiveSelectionForeground": "#232629",
      "list.hoverBackground": "#E6E8EA",
      "list.focusBackground": "#D3D7DA",
      "list.focusForeground": "#232629",
      "list.focusOutline": "#00000000",
      "list.focusAndSelectionOutline": "#00000000",
      "list.inactiveFocusOutline": "#00000000",
      "editor.selectionBackground": "#C2E0F5",
      "button.background": "#3DAEE9",
      "button.foreground": "#232629"
    },
    // Compensate observed rendering shift: #31363B becomes #35383D.
    // #2D3439 targets the native KDE titlebar color #31363B on screen.
    "[Dark Modern]": {
      "foreground": "#EFF0F1",
      "focusBorder": "#3DAEE9",
      "titleBar.activeBackground": "#2D3439",
      "titleBar.inactiveBackground": "#2D3439",
      "titleBar.activeForeground": "#EFF0F1",
      "activityBar.background": "#2D3439",
      "activityBar.foreground": "#EFF0F1",
      "activityBar.border": "#2D3439",
      "activityBar.activeBorder": "#3DAEE9",
      "sideBar.background": "#2D3439",
      "sideBar.foreground": "#EFF0F1",
      "sideBar.border": "#4D5257",
      "sideBarSectionHeader.background": "#2D3439",
      "editor.background": "#232629",
      "editor.foreground": "#EFF0F1",
      "editorGroupHeader.tabsBackground": "#2D3439",
      "editorGroupHeader.noTabsBackground": "#2D3439",
      "tab.activeBackground": "#232629",
      "tab.activeForeground": "#EFF0F1",
      "tab.activeBorder": "#232629",
      "tab.activeBorderTop": "#3DAEE9",
      "tab.inactiveBackground": "#2D3439",
      "tab.inactiveForeground": "#BDC3C7",
      "tab.border": "#4D5257",
      "panel.background": "#2D3439",
      "panel.border": "#4D5257",
      "statusBar.background": "#2D3439",
      "statusBar.foreground": "#EFF0F1",
      "statusBar.inactiveBackground": "#2D3439",
      "statusBar.border": "#4D5257",
      "statusBar.noFolderBackground": "#2D3439",
      "statusBar.debuggingBackground": "#2D3439",
      "statusBar.debuggingForeground": "#EFF0F1",
      "list.activeSelectionBackground": "#3D5968",
      "list.activeSelectionForeground": "#EFF0F1",
      "list.inactiveSelectionBackground": "#3B4248",
      "list.inactiveSelectionForeground": "#EFF0F1",
      "list.hoverBackground": "#3D4349",
      "list.focusBackground": "#3D5968",
      "list.focusForeground": "#EFF0F1",
      "list.focusOutline": "#00000000",
      "list.focusAndSelectionOutline": "#00000000",
      "list.inactiveFocusOutline": "#00000000",
      "editor.selectionBackground": "#264F63",
      "button.background": "#3DAEE9",
      "button.foreground": "#232629"
    }
  }
}
