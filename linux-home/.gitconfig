[user]
	email = haakon.skogsrud@pm.me
	name = Håkon Skogsrud
[push]
	autoSetupRemote = true
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
[credential "https://github.com"]
	helper = 
	helper = !/nix/store/dpiajg8vgzpaq74jc79j01fd5bja3cik-gh-2.98.0/bin/.gh-wrapped auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/nix/store/dpiajg8vgzpaq74jc79j01fd5bja3cik-gh-2.98.0/bin/.gh-wrapped auth git-credential
