[user]
	email = haakon.skogsrud@pm.me
	name = Håkon Skogsrud
[push]
	autoSetupRemote = true
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
[include]
	path = ~/.gitconfig.local
